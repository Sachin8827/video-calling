# ─── Application ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ─── Database ─────────────────────────────────────────────────────────────────
DATABASE_URL=postgresql://user:password@localhost:5432/auth_db
DATABASE_POOL_MIN=2
DATABASE_POOL_MAX=10

# ─── JWT ──────────────────────────────────────────────────────────────────────
# Generate with: node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_SECRET=CHANGE_ME_MINIMUM_64_CHARS_RANDOM_HEX_STRING_NEVER_COMMIT_THIS
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=7d

# ─── Security ─────────────────────────────────────────────────────────────────
ARGON2_MEMORY_COST=65536
ARGON2_TIME_COST=3
ARGON2_PARALLELISM=4

RATE_LIMIT_TTL=900
RATE_LIMIT_MAX_PER_IP=20
RATE_LIMIT_MAX_PER_ACCOUNT=5

CSRF_TOKEN_EXPIRY_HOURS=24
SESSION_MAX_CONCURRENT=5

# ─── CORS ─────────────────────────────────────────────────────────────────────
ALLOWED_ORIGIN=http://localhost:3001

# ─── Redis (used for matchmaking queue + Socket.IO horizontal scaling) ─────────
REDIS_URL=redis://localhost:6379

# ─── TURN / STUN (coturn — self-hosted, free) ─────────────────────────────────
# STUN: use Google STUN (free, no setup needed)
# STUN_SERVER_URL=stun:stun.l.google.com:19302
#
# TURN: self-host coturn on your VPS
TURN_SERVER_URL=turn:your-server-ip:3478
TURN_USERNAME=turnuser
TURN_CREDENTIAL=turnpassword

# ─── MediaSoup SFU (Group Calls) ──────────────────────────────────────────────
# Requires GCC >= 10 to compile from source.
# Install with a newer toolchain or via Docker (see docker-compose.yml).
MEDIASOUP_LISTEN_IP=0.0.0.0
MEDIASOUP_ANNOUNCED_IP=127.0.0.1   # Replace with your PUBLIC server IP in production
MEDIASOUP_MIN_PORT=40000
MEDIASOUP_MAX_PORT=49999

# ─── Audit ────────────────────────────────────────────────────────────────────
AUDIT_RETENTION_DAYS=90
